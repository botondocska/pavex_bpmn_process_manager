{
  "realm": "test",
  "enabled": true,
  "sslRequired": "none",
  "groups": [{ "name": "BPM-Finance" }],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.com",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Test",
      "groups": ["BPM-Finance"],
      "credentials": [
        { "type": "password", "value": "password", "temporary": false }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "bpm",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${PX_AUTH__CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:8000/auth/callback"],
      "webOrigins": ["http://localhost:8000"],
      "defaultClientScopes": ["profile", "email", "roles", "web-origins"],
      "protocolMappers": [
        {
          "name": "group",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "group",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}